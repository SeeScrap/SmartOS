# --- build output ----------------------------------------------------------
# PlatformIO builds here; .pio/cli is this project's command-line build folder
# (see the note at the bottom of platformio.ini about why there are two).
.pio/

# Generated by PlatformIO from sdkconfig.defaults on every configure. The
# defaults file is the one that is edited and the one worth keeping; this is
# its 98 KB expansion, and committing it only invites editing the wrong file.
sdkconfig.*
!sdkconfig.defaults

# Fetched by the ESP-IDF component manager from src/idf_component.yml. The
# exact version is pinned in dependencies.lock, which IS committed, so a clone
# gets the same littlefs this was built against.
managed_components/

# --- editor and tools ------------------------------------------------------
.vscode/
__pycache__/
*.pyc

# --- things that should never be committed ---------------------------------
*.log
*.bak
*.orig
*.zip
Thumbs.db
.DS_Store
